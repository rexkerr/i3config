# This is my personal i3 configuration file.  
#
# Proceed with caution if you choose to copy any of this. :-)
#
# i3 config file (v4)
#
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

# ALT as modifider
set $mod Mod1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 8

# class         border   bg      text  indicator  child_border
client.focused #555555 #555555 #FFFFFF #2E9EF4     #CC0000

default_border pixel 2
default_floating_border pixel 2

for_window [class=.*] border pixel 2

popup_during_fullscreen all

# Mark application activation requests urgent instead of letting them steal focus.
focus_on_window_activation urgent

include config.d/05-i3-management.conf
include config.d/10-navigation.conf
include config.d/15-workspaces.conf
include config.d/20-desktop-controls.conf
include config.d/25-audio.conf
include config.d/30-screens.conf
include config.d/35-applications.conf
include config.d/40-window-management.conf
include config.d/45-bar.conf
include config.d/50-window-rules.conf
include config.d/55-mouse.conf
include config.d/99-launch.conf
include system.conf

