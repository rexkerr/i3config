# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}



# order += "ipv6"
order += "read_file cpumode"
order += "read_file PausedNotifications"
order += "disk /"
order += "disk /mnt/datadrive/"
order += "path_exists OVPN"
order += "path_exists HVPN"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "volume master"
order += "tztime utc"
order += "tztime cet"
order += "tztime local"

read_file cpumode {
     format = "%content"
     format_bad = "CPU: <no file>"
     path = "~/.cpumode"
}

read_file PausedNotifications {
    format = "%content"
    format_bad = ""
    path = "~/.notifications_paused"
}

wireless _first_ {
        format_up = "W:%ip (%essid %quality)"
        format_down = "W: down"
}

ethernet _first_ {
        # if you use %speed, i3status requires root privileges
        format_up = "E:%ip (%speed)"
        format_down = "E⤵"
}

battery all {
        format = "%status %percentage %remaining %consumption"
        last_full_capacity = true
        format_percentage = "%.00f%s"
}

path_exists OVPN {
    # path exists when a VPN tunnel launched by nmcli/nm-applet is active
    path = "/proc/sys/net/ipv4/conf/OfficeVPN"
    format_down="OVPN⤵"
}

path_exists HVPN {
    # path exists when a VPN tunnel launched by nmcli/nm-applet is active
    path = "/proc/sys/net/ipv4/conf/KerrNetVPN"
    format_down="HVPN⤵"
}

tztime utc {
        format = "(%Z:%H)"
        timezone = "UTC"
}

tztime cet {
        format = "(%Z:%H)"
        timezone = "Europe/Paris"
}

tztime local {
        format = "%Y-%m-%d %l:%M %P"
}

cpu_usage {
        format = "%usage cpu"
}

cpu_temperature 0 {
        format = "%degrees°C"
        max_threshold = 75
}

disk "/" {
        format = "/:%avail"
        format_below_threshold = "LOW /:%avail"
        threshold_type = "percentage_avail"
        low_threshold = 10
}

disk "/mnt/datadrive/" {
        format = "data:%avail"
        format_below_threshold = "LOW data:%avail"
        threshold_type = "percentage_avail"
        low_threshold = 10
}

volume master {
        format = "♪: %volume"
        format_muted = "♪: muted (%volume)"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}
